# victron-bm-webui configuration
# Copy this file to config.yaml and adjust values as needed.
#
# Note: Device credentials (MAC, advertisement key) and SMTP settings
# are configured in .env, not here. See .env.example for details.

# Device display name
device:
  name: "BMV-712 Smart"

# BLE polling settings
ble:
  poll_interval_seconds: 10   # How often to read BLE data
  max_scanner_restarts: 3     # Consecutive scanner failures before process exit (Docker restarts container)

# Database settings
database:
  path: "/data/victron-bm.db"
  retention_days: 30          # Delete readings older than this

# Alarm thresholds (set to null to disable individual alarms)
alarms:
  low_voltage: 11.5           # Volts
  high_voltage: 15.0          # Volts
  low_soc: 20.0               # Percent
  high_temperature: 45.0      # Celsius
  low_temperature: 0.0        # Celsius
  ac_power_voltage: null      # Volts - legacy AC threshold; see ac_detection below

# Mains (AC) presence detection.
#
# A BMV-712 is a shunt and has no AC input, so mains presence is inferred
# from battery current and voltage. Current is the primary signal: once the
# inverter starts drawing from the battery, current goes firmly negative
# well before voltage sags. Voltage acts as a secondary check, with a
# hysteresis band so a brief dip cannot flip the state on its own.
#
# The resulting state is published as `ac_power` on GET /api/v1/status.
ac_detection:
  voltage_on: null            # Volts - mains considered back at/above this.
                              # null = use alarms.ac_power_voltage, else 13.55
  voltage_off: null           # Volts - mains considered lost below this.
                              # null = alarms.ac_power_voltage - 0.2, else 13.40
  discharge_current: -1.0     # Amps - at/below this the battery is definitely
                              # carrying the load, regardless of voltage
  charge_current: 2.0         # Amps - at/above this the mains-fed charger is
                              # definitely running, so mains is back. Restores
                              # far faster than waiting for voltage_on out of a
                              # deep discharge. Set to 0 to disable if an
                              # independent DC source (solar/MPPT, alternator)
                              # can also charge the bank.
  debounce_samples: 2         # Consecutive agreeing readings before the state
                              # flips (2 x poll_interval_seconds = 20s default)

# Notification settings (which events trigger emails)
notifications:
  alarm_triggered: true       # Device alarm state changes
  alarm_cleared: true         # Device alarm clears
  threshold_exceeded: true    # App-defined threshold exceeded
  device_offline: true        # No BLE data for >5 minutes
  device_online: true         # BLE data resumes after offline
  ac_power_lost: true         # Mains presence lost (see ac_detection)
  ac_power_restored: true     # Mains presence restored (see ac_detection)
